  inp=orcsml.inp
  out=orcsml.out
}
run = check
opt{
  freeze = 0x,0y,0z,2,7
}
# sdfsdf
#projection = yes
#projection.fock = yes
#projection.sigma = 2e0
ecprad = 5e0
dft{ # modified B3LYP functional with 40% HF exchange -  is not applied here, see orca_dft section
name = b3lyp
xhf=0.40
x_b88 = 0.54
c_lyp = 0.81
}
orca_dft{
  RKS=true
  6-31G=true
  scf{
    Guess=Hueckel
  }
  method{
    # modified B3LYP functional with 40% HF exchange
    Exchange=X_B88
    Correlation=C_LYP
    LDAOpt=C_VWN5
    ScalHFX =0.40
    ScalDFX =0.60   # = 1 - a
    ScalGGAC=0.81   # = c
    ScalLDAC=0.19   # = 1 - c
   }  
  replace_atom{
    Ca_ecp = Sr
    F_shl=F
    Ca_ecp1=Mg
  }
}

